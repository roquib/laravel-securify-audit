{
    "name": "skycoder/laravel-securify-audit",
    "description": "Laravel Security & Audit Scanner by Skycoder",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Al Kazi",
            "email": "akashcseuu026@gmail.com",
            "homepage": "https://github.com/skycoder026"
        }
    ],
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^1.10",
        "mockery/mockery": "^1.5"
    },
    "suggest": {
        "larastan/larastan": "Required for Laravel static analysis integration with PHPStan."
    },
    "autoload": {
        "psr-4": {
            "Skycoder\\SecurifyAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skycoder\\SecurifyAudit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Skycoder\\SecurifyAudit\\SecurifyAuditServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse --memory-limit=2G",
        "lint": "pint --test",
        "lint-fix": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
